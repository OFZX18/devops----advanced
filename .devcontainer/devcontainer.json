{
  "name": "DevOps Advanced",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.override.yaml"
  ],
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "initializeCommand": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock ghcr.io/mbo-college-zuidoost/development-proxy:1.0",
  "customizations": {
    "vscode": {
      "settings": {
        "php.executablePath": "/usr/local/bin/php"
      },
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  }
}
